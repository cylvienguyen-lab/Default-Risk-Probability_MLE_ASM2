  "policy": {"empty_application_snapshot": "error", "empty_raw_lms_snapshot": "error", "empty_mob6_label_snapshot": "allow_with_audit", "missing_clickstream_before_coverage_start": "allow", "missing_clickstream_within_coverage": "error", "bronze_csv_collect_to_driver": true, "max_bronze_rows": 1000000},
  "runtime": {"spark_master": "local[2]", "spark_shuffle_partitions": 2, "log_level": "ERROR"},
